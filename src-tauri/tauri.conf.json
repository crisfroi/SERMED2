{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Renaprosa",
  "version": "0.1.0",
  "identifier": "com.sermed.renaprosa",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Renaprosa",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../public/pwa-192x192.png",
      "../public/pwa-512x512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
