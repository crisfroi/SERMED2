{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": false,
    "noFallthroughCasesInSwitch": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@hosix/*": ["./packages/hosix/src/*"]
    }
  },
  "include": [
    "src",
    "packages/hosix/src/components/PHASE_2_CLINICAL",
    "packages/hosix/src/components/common",
    "packages/hosix/src/components/ASIS_15_Imagenes",
    "packages/hosix/src/components/ASIS_14_Diagnostico",
    "packages/hosix/src/components/ASIS_13_EHR",
    "packages/hosix/src/components/ASIS_12_Farmacoterapia",
    "packages/hosix/src/components/ASIS_11_Referencia",
    "packages/hosix/src/components/ASIS_10_Regimenes",
